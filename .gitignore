# Large / private artifacts
# data/: keep the folder skeleton (README + .gitkeep files), ignore the contents
data/**
!data/**/
!data/**/.gitkeep
!data/README.md
models/*
!models/.gitkeep
*.mp4
*.mov
*.mkv
*.avi
*.onnx
*.pt
*.pth
*.db
*.duckdb
*.sqlite
outputs/
!data/outputs/
!data/outputs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
dist/
build/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
