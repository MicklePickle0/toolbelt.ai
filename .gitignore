# Large artifacts
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.onnx
*.pt
*.pth
*.ckpt
*.db
*.duckdb
*.sqlite
outputs/

# data/ and models/: anything made by hand or slow to rebuild is tracked (labels,
# calibrations, manifest, the event DB with review edits, the models in use); videos,
# caches, frames, datasets and outputs are not (rebuilt from the videos). See data/README.md.
# Order matters: the last matching rule wins.
data/**
!data/**/
!data/**/.gitkeep
!data/README.md
!data/manifest.yaml
!data/videos.txt
!data/setter_eyes.db
!data/labels/**
data/labels/**/*.jpg
data/labels/**/*.png
!data/calibration/**
!data/rosters/**
!data/folders.yaml
models/**
!models/**/
!models/.gitkeep
!models/contacts/touch_scorer.pkl
# The detector in use goes through Git LFS (.gitattributes); old runs and .ckpt stay local.
!models/rfdetr/batch123_medium_1280/checkpoint_best_total.pth
!models/rfdetr/batch123_medium_1280/training_config.json
!models/rfdetr/batch123_medium_1280/metrics.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
dist/
build/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
